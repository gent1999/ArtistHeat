API_URL=http://localhost:4100

NEXT_PUBLIC_SITE_NAME=ArtistHeat

# GA4 measurement ID (e.g. G-XXXXXXXXXX) from the GA4 property's Admin ->
# Data Streams page. Optional -- if unset, GoogleAnalytics simply isn't
# rendered (public site pages only, never on /admin).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Only needed if Search Console asks for meta-tag verification specifically.
# If artistheat.com is already verified via DNS TXT record, leave unset.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
